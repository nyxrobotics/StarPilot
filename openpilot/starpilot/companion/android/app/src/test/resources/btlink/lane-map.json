 "announcement": [
  {
   "name": "nav-only",
   "body": "{\"nav\":true}",
   "expect": {
    "nav": true,
    "maps": false
   },
   "note": "contract version 2, byte for byte"
  },
  {
   "name": "maps-only",
   "body": "{\"maps\":true}",
   "expect": {
    "nav": false,
    "maps": true
   }
  },
  {
   "name": "both",
   "body": "{\"nav\":true,\"maps\":true}",
   "expect": {
    "nav": true,
    "maps": true
   },
   "note": "what a Companion of version 3 sends to a bridge that said maps and pushNav"
  },
  {
   "name": "both-reversed",
   "body": "{\"maps\":true,\"nav\":true}",
   "expect": {
    "nav": true,
    "maps": true
   },
   "note": "read as JSON, as the bridge reads {\"nav\":true} today: the order is free"
  },
  {
   "name": "spaces",
   "body": "{\"nav\": true, \"maps\": true}",
   "expect": {
    "nav": true,
    "maps": true
   }
  },
  {
   "name": "nav-with-a-space",
   "body": "{\"nav\": true}",
   "expect": {
    "nav": true,
    "maps": false
   },
   "note": "as the bridge of version 2 reads it"
  },
  {
   "name": "trailing-newline",
   "body": "{\"maps\":true}\n",
   "expect": {
    "nav": false,
    "maps": true
   }
  },
  {
   "name": "empty-body",
