{
 "version": 1,
 "note": "hand-written expectations; see tools/btlab/contract/vectors_maps.py",
 "planner": {
  "constants": {
   "min_chunk": 1024,
   "map_min_chunk": 4096,
   "map_start_bytes": 4096,
   "max_chunk": 65536,
   "packet_data": 239,
   "start_bytes": 6144,
   "ewma": 0.5,
   "route_cap_s": 5.0,
   "map_cap_s": 1.0
  },
  "rule": "size = int(rate * cap_s) (start_bytes before the first measurement); size = max(min_chunk, min(65536, size)); size -= size % 239; chunk = min(max(size, min_chunk), remaining); 0 when nothing remains. min_chunk is 1024 for the route and for the answers of searches and 4096 for the class map",
  "cases": [
   {
    "min_chunk": 4096,
    "start_bytes": 4096,
    "name": "map-first-chunk",
    "cap_s": 1.0,
    "observations": [],
    "remaining": 1000000,
    "expect": 4096,
    "note": "no rate yet: the class map starts at its minimum (the route starts at 6,144, which is 25 packets of 239: 5,975)"
   },
   {
    "min_chunk": 4096,
    "name": "map-first-chunk-short-job",
    "cap_s": 1.0,
    "observations": [],
    "remaining": 3000,
    "expect": 3000
   },
   {
    "min_chunk": 4096,
    "name": "map-45-kb-s",
    "cap_s": 1.0,
    "observations": [
     [
      45600,
      1.0
     ]
    ],
    "remaining": 1000000,
    "expect": 45410,
    "note": "45,600 bytes in one second: 190 packets"
   },
   {
    "min_chunk": 4096,
    "name": "map-rate-is-smoothed",
    "cap_s": 1.0,
    "observations": [
     [
      40000,
      1.0
     ],
     [
      20000,
      1.0
     ]
    ],
    "remaining": 1000000,
    "expect": 29875,
    "note": "(40,000 + 20,000) / 2 = 30,000: 125 packets"
   },
   {
    "min_chunk": 4096,
    "name": "map-12-9-kb-s",
    "cap_s": 1.0,
    "observations": [
     [
      12900,
      1.0
     ]
    ],
    "remaining": 1000000,
    "expect": 12667,
    "note": "53 packets"
   },
   {
    "min_chunk": 4096,
    "name": "map-slow-link-hits-the-minimum",
    "cap_s": 1.0,
    "observations": [
     [
      900,
      3.0
     ]
    ],
    "remaining": 1000000,
    "expect": 4096,
    "note": "300 bytes per second: the chunk is the 4 KiB minimum of the class map (whole packets would be 4,063)"
   },
   {
    "min_chunk": 1024,
    "name": "route-slow-link-hits-the-minimum",
    "cap_s": 5.0,
    "observations": [
     [
      900,
      10.0
     ]
    ],
    "remaining": 1000000,
    "expect": 1024,
    "note": "90 bytes per second: 450 in five seconds"
   },
   {
    "min_chunk": 4096,
    "name": "map-3-8-kb-s-is-lifted-to-4-kib",
    "cap_s": 1.0,
    "observations": [
     [
      3800,
      1.0
     ]
    ],
    "remaining": 1000000,
    "expect": 4096,
    "note": "3,800 bytes: below the minimum, so every chunk after the first is a sample of the meter"
   },
   {
    "min_chunk": 4096,
    "name": "map-just-above-the-minimum",
    "cap_s": 1.0,
    "observations": [
     [
      4400,
      1.0
     ]
    ],
    "remaining": 1000000,
    "expect": 4302,
    "note": "4,400 is 18 packets of 239 and 98 over: 4,302"
   },
   {
    "min_chunk": 4096,
    "name": "map-last-chunk-is-the-rest",
    "cap_s": 1.0,
    "observations": [
     [
      45600,
      1.0
     ]
    ],
    "remaining": 777,
    "expect": 777
   },
   {
    "min_chunk": 4096,
    "name": "map-nothing-left",
    "cap_s": 1.0,
    "observations": [
     [
      45600,
      1.0
     ]
    ],
    "remaining": 0,
    "expect": 0
   },
   {
    "min_chunk": 1024,
    "name": "route-first-chunk",
    "cap_s": 5.0,
    "observations": [],
    "remaining": 1000000,
    "expect": 5975
   },
   {
    "min_chunk": 1024,
    "name": "route-45-kb-s-is-capped-by-64-kib",
    "cap_s": 5.0,
    "observations": [
     [
      45600,
      1.0
     ]
    ],
    "remaining": 1000000,
    "expect": 65486,
    "note": "228,000 is above 65,536: 274 packets"
   },
   {
    "min_chunk": 1024,
    "name": "route-12-9-kb-s",
    "cap_s": 5.0,
    "observations": [
     [
      12900,
      1.0
     ]
    ],
    "remaining": 1000000,
    "expect": 64291,
    "note": "64,500: 269 packets"
   },
   {
    "min_chunk": 1024,
    "name": "route-3-kb-s",
    "cap_s": 5.0,
    "observations": [
     [
      3000,
      1.0
     ]
    ],
    "remaining": 1000000,
    "expect": 14818,
    "note": "15,000: 62 packets"
   },
   {
    "min_chunk": 1024,
    "name": "zero-seconds-is-not-a-measurement",
    "cap_s": 1.0,
    "observations": [
     [
      45600,
      0.0
     ]
    ],
    "remaining": 1000000,
    "expect": 5975
   }
  ]
 },
 "lane_scripts": [
  {
   "name": "strict-priority-at-one-instant",
   "requests": [
    [
     "m1",
     "map",
     0.0,
     0.1
    ],
    [
     "r1",
     "bulk",
     0.0,
     0.1
    ],
    [
     "s1",
     "small",
     0.0,
     0.1
    ],
    [
     "i1",
     "interactive",
     0.0,
     0.1
    ]
   ],
   "expect_start_order": [
    "i1",
    "s1",
    "r1",
    "m1"
   ],
   "note": "interactive, small, the route, then the map"
  },
  {
   "name": "a-map-chunk-in-flight-is-never-preempted",
   "requests": [
    [
     "m1",
     "map",
     0.0,
     1.0
    ],
    [
     "i1",
     "interactive",
     0.1,
     0.1
    ],
    [
     "r1",
     "bulk",
     0.2,
     0.5
    ]
   ],
   "expect_start_order": [
    "m1",
    "i1",
    "r1"
   ],
   "expect_wait_s": {
    "i1": 0.9,
    "r1": 0.9
   },
   "note": "the interactive request waits for the rest of the chunk (0.9 s), no more"
  },
  {
   "name": "the-route-goes-before-a-waiting-map-chunk",
   "requests": [
    [
     "m1",
     "map",
     0.0,
     1.0
    ],
    [
     "m2",
     "map",
     0.1,
     1.0
    ],
    [
     "r1",
     "bulk",
     0.2,
     0.5
    ]
   ],
   "expect_start_order": [
    "m1",
    "r1",
    "m2"
   ],
   "expect_wait_s": {
    "r1": 0.8
   }
  },
  {
   "name": "first-come-first-served-inside-the-map-class",
   "requests": [
    [
     "m1",
     "map",
     0.0,
     0.5
    ],
    [
     "m2",
     "map",
     0.0,
     0.5
    ],
    [
     "m3",
     "map",
     0.1,
     0.5
    ]
   ],
   "expect_start_order": [
    "m1",
    "m2",
    "m3"
   ]
  },
  {
   "name": "a-search-waits-for-one-map-chunk-at-most",
   "requests": [
    [
     "m1",
     "map",
     0.0,
     1.0
    ],
    [
     "m2",
     "map",
     0.0,
     1.0
    ],
    [
     "g1",
     "small",
     0.5,
     0.2
    ]
   ],
   "expect_start_order": [
    "m1",
    "g1",
    "m2"
   ],
   "expect_wait_s": {
    "g1": 0.5
   },
   "note": "a geocode is a small request: it goes after the chunk in flight and before the next one"
  },
  {
   "name": "a-style-tile-chunk-is-a-map-request",
   "requests": [
    [
     "s1",
     "map",
     0.0,
     0.5
    ],
    [
     "r1",
     "bulk",
     0.0,
     0.5
    ]
   ],
   "expect_start_order": [
    "r1",
    "s1"
   ]
  }
 ],
