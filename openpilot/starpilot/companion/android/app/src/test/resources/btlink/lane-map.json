   "expect": {
    "nav": false,
    "maps": false
   }
  },
  {
   "name": "empty-object",
   "body": "{}",
   "expect": {
    "nav": false,
    "maps": false
   }
  },
  {
   "name": "maps-false",
   "body": "{\"maps\":false}",
   "expect": {
    "nav": false,
    "maps": false
   }
  },
  {
   "name": "maps-one",
   "body": "{\"maps\":1}",
   "expect": {
    "nav": false,
    "maps": false
   }
  },
  {
   "name": "maps-string",
   "body": "{\"maps\":\"true\"}",
   "expect": {
    "nav": false,
    "maps": false
   }
  },
  {
   "name": "maps-null",
   "body": "{\"maps\":null}",
   "expect": {
    "nav": false,
    "maps": false
   }
  },
  {
   "name": "nav-true-maps-false",
